# Development-only local npm example. Never fill this with production values.
# The root npm run dev copies the filled root .env to packages/dashboard/.env.
# For Docker, use the separate sanitized docker/*.env.example templates.
DATABASE_URL=postgresql://development-user:replace-me@development-neon-host/neondb?sslmode=require
DISCORD_TOKEN=replace-with-development-bot-token
DISCORD_BOT_TOKEN=replace-with-the-same-development-bot-token
GUILD_ID=replace-with-development-guild-id
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
LAVA_HOST=replace-with-external-lavalink-host
LAVA_PORT=1339
LAVA_PASS=replace-with-development-lavalink-password
LAVA_SECURE=false
# No SHADOW_DB_URL is needed at runtime; schema work has a separate review.
# Browser URL, local listener port, and Discord portal redirect must agree exactly.
NEXTAUTH_URL=http://127.0.0.1:3001
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Discord portal redirect: http://127.0.0.1:3001/api/auth/callback/discord
NEXTAUTH_SECRET=replace-with-a-development-only-secret
DISCORD_CLIENT_ID=replace-with-development-application-id
DISCORD_CLIENT_SECRET=replace-with-development-application-secret
# Future production host browser: http://127.0.0.1:3000
# Future container-only API_INTERNAL_URL/NEXTAUTH_URL_INTERNAL: http://dashboard:3000
# Browser code always uses /api/trpc. Do not expose an internal URL as NEXT_PUBLIC_*.
