# Non-secret Compose inputs. Supply private files outside the repository.
BOT_ENV_FILE=C:/path/to/private/bot.env
DASHBOARD_ENV_FILE=C:/path/to/private/dashboard.env
# Default production loopback port is 3000. Use a free distinct port for tests.
DASHBOARD_PORT=3000
# Public build-time URL; rebuild dashboard if changed. This is not a secret.
NEXT_PUBLIC_INVITE_URL=https://discord.com/oauth2/authorize?client_id=REPLACE&scope=bot
